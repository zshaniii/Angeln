      <path d="M22 70c8 24 34 34 46 24" fill="none" stroke="#4a5f55" stroke-width="2"/>
      <path d="M18 80l36 22M26 66l40 30M34 58l38 26M46 56l26 18" stroke="#4a5f55" stroke-width="1.5" opacity=".8"/>
    </svg></div><div class="slide ph" data-name="BILD_ERSETZEN_KESCHER_1"><img src="BILD_ERSETZEN_KESCHER_1" alt="" onerror="this.style.display='none'"></div><div class="slide ph" data-name="BILD_ERSETZEN_KESCHER_2"><img src="BILD_ERSETZEN_KESCHER_2" alt="" onerror="this.style.display='none'"></div></div></div>
  <div class="body">
