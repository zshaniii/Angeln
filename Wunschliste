</main>
<footer>Preise Stand 16.11.2026 · Frohe Weihnachten! 🎄</footer>
<script>
document.querySelectorAll('.art').forEach(function(art){
  var sl=art.querySelector('.slides'),n=sl.children.length,d=document.createElement('div');
  d.className='dots';
  for(var i=0;i<n;i++){d.appendChild(document.createElement('i'))}
  art.appendChild(d);
  function upd(){var k=Math.round(sl.scrollLeft/sl.clientWidth);[].forEach.call(d.children,function(e,j){e.className=j===k?'on':''})}
  sl.addEventListener('scroll',upd,{passive:true});upd();
});
</script>
</body>
</html>
