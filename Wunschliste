<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Shanes Wunschliste</title>
<style>
:root{--bg:#f6f1e7;--card:#fffdf8;--ink:#24302a;--muted:#5d6b63;--green:#1f4d3a;--red:#b3262e;--gold:#c8963e;--line:#e4dccb;--art:#e9efe6;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1c16;--card:#17281f;--ink:#f3ecdc;--muted:#a9b8ae;--green:#7fc4a0;--red:#e0555d;--gold:#e2b25c;--line:#284536;--art:#1f3829}}
:root[data-theme="dark"]{--bg:#0f1c16;--card:#17281f;--ink:#f3ecdc;--muted:#a9b8ae;--green:#7fc4a0;--red:#e0555d;--gold:#e2b25c;--line:#284536;--art:#1f3829}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,"Times New Roman",serif;line-height:1.5}
header{text-align:center;padding:2.5rem 1.2rem 1.5rem;background:linear-gradient(160deg,#1f4d3a,#13291f);color:#f7efdd;position:relative;overflow:hidden}
header:after{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.55) 1.5px,transparent 2px),radial-gradient(circle,rgba(255,255,255,.35) 1px,transparent 1.5px);background-size:90px 90px,55px 55px;background-position:0 0,30px 40px;opacity:.5;pointer-events:none}
header>*{position:relative;z-index:1}
.star{font-size:2rem;color:#e2b25c}
h1{margin:.2rem 0;font-size:clamp(1.8rem,6vw,2.8rem);letter-spacing:.02em}
header p.lead{font:italic 1.25rem Georgia,serif;color:#f7efdd;margin:.2rem auto .5rem}
header p{margin:.3rem auto 0;max-width:34rem;color:#d9d2bf;font-family:system-ui,sans-serif;font-size:.95rem}
main{max-width:46rem;margin:0 auto;padding:1.5rem 1rem 3rem;display:grid;gap:1.4rem}
.card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,.08);display:grid;grid-template-columns:1fr}
@media(min-width:640px){.card{grid-template-columns:240px 1fr}}
.art{background:var(--art);position:relative;min-height:230px;overflow:hidden}
.slides{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;height:100%;min-height:230px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.slides::-webkit-scrollbar{display:none}
.slide{flex:0 0 100%;scroll-snap-align:center;position:relative;display:flex;align-items:center;justify-content:center;padding:1.2rem}
.slide svg{width:150px;height:150px;max-width:100%}
.slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:var(--art)}
.slide.ph::before{content:attr(data-name);font:600 .75rem ui-monospace,monospace;color:var(--muted);text-align:center;padding:.9rem;border:2px dashed var(--line);border-radius:10px;max-width:85%;word-break:break-all}
.dots{position:absolute;bottom:.55rem;left:0;right:0;display:flex;justify-content:center;gap:.4rem;pointer-events:none}
.dots i{width:.5rem;height:.5rem;border-radius:50%;background:var(--muted);opacity:.35}
.dots i.on{background:var(--red);opacity:1}
.num{position:absolute;top:.7rem;left:.7rem;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--red);color:#fff;font:700 1.4rem/2.6rem Georgia,serif;text-align:center;box-shadow:0 2px 6px rgba(0,0,0,.3);border:2px solid var(--gold)}
.body{padding:1.2rem 1.3rem 1.4rem;font-family:system-ui,sans-serif}
.shop{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
h2{margin:.15rem 0 .5rem;font:700 1.35rem/1.25 Georgia,serif;color:var(--green)}
ul{margin:.4rem 0 .9rem;padding-left:1.1rem;color:var(--muted);font-size:.92rem}
.row{display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap}
.price{font:700 1.3rem Georgia,serif;color:var(--ink)}
.price small{display:block;font:400 .72rem system-ui,sans-serif;color:var(--muted)}
a.btn{display:inline-block;background:var(--red);color:#fff;text-decoration:none;font-weight:600;padding:.65rem 1.1rem;border-radius:999px;font-size:.95rem}
a.btn:hover,a.btn:focus-visible{filter:brightness(1.1);outline:2px solid var(--gold);outline-offset:2px}
footer{text-align:center;color:var(--muted);font:.85rem system-ui,sans-serif;padding:0 1rem 2rem}
</style>
</head>
<body>
<header>
